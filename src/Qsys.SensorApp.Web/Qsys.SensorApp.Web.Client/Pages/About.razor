@page "/about"
@using System.Globalization
<PageTitle>About | Qsys Sensor App</PageTitle>
<section class="page-heading"><p class="eyebrow">ABOUT THE PROJECT</p><h1>Qsys Sensor App</h1><p class="lede">A warehouse indoor navigation platform, built in small, verifiable milestones.</p></section>
<section class="about-panel"><div><span class="eyebrow">LATEST COMMIT</span><p>@LatestCommitDate</p></div><div><span class="eyebrow">PURPOSE</span><p>Help warehouse teams understand indoor movement through calibrated maps, device sensors and reliable positioning.</p></div><div><span class="eyebrow">CURRENT FOUNDATION</span><p>.NET 10 · Blazor WebAssembly · ASP.NET Core API · Clean Architecture</p></div><div><span class="eyebrow">CURRENT MILESTONE</span><p>Milestone 10 — Warehouse Digital Twin in progress. View live positions, movement history, replay and local visit heatmaps with activity intelligence.</p></div></section>

@code {
    private static string LatestCommitDate
    {
        get
        {
            return DateTimeOffset.TryParse(GitCommitInfo.Date, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDate)
                ? parsedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm zzz", CultureInfo.InvariantCulture)
                : "Unavailable";
        }
    }
}
