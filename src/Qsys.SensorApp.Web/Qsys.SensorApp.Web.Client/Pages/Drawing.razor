@page "/drawing"
<PageTitle>Drawing | Qsys Sensor App</PageTitle>
<section class="page-heading"><p class="eyebrow">MAP WORKSPACE</p><h1>Drawing</h1><p class="lede">A clear view of the warehouse plan and its active layers.</p></section>
<div class="drawing-toolbar"><span class="toolbar-title">North warehouse <span class="muted">/ Floor 1</span></span><span class="toolbar-actions"><button class="quiet-button" @onclick="ZoomOut" aria-label="Zoom out">−</button><span>@zoom%</span><button class="quiet-button" @onclick="ZoomIn" aria-label="Zoom in">+</button><button class="quiet-button" @onclick="ResetZoom">Reset</button></span></div>
<div class="map-layout"><section class="map-canvas" aria-label="Warehouse drawing"><svg viewBox="0 0 800 460" role="img" aria-label="Illustrative warehouse floor plan" style="transform:scale(@(zoom / 100.0));"><rect x="24" y="24" width="752" height="412" rx="8" class="floor"/><path d="M85 100H715M85 180H715M85 260H715M85 340H715" class="aisle"/><path d="M170 66V390M330 66V390M490 66V390M650 66V390" class="rack-line"/><g class="rack" style="display:@(showRacks ? "initial" : "none")"><rect x="105" y="118" width="130" height="40"/><rect x="265" y="198" width="130" height="40"/><rect x="425" y="278" width="130" height="40"/><rect x="585" y="118" width="130" height="40"/></g><g style="display:@(showRoute ? "initial" : "none")"><path d="M100 380 C220 380 240 300 400 300 S560 220 700 220" class="route"/><circle cx="100" cy="380" r="9" class="marker"/><circle cx="700" cy="220" r="9" class="destination"/></g><text x="46" y="55">RECEIVING</text><text x="658" y="415">DOCK 04</text></svg></section>
<aside class="layer-panel"><h2>Layers</h2><label><input type="checkbox" @bind="showRacks" /> Storage racks</label><label><input type="checkbox" @bind="showRoute" /> Route preview</label><p class="small-note">Illustrative preview · no map imported</p></aside></div>
@code { private int zoom = 100; private bool showRacks = true; private bool showRoute = true; private void ZoomIn() => zoom = Math.Min(160, zoom + 10); private void ZoomOut() => zoom = Math.Max(60, zoom - 10); private void ResetZoom() => zoom = 100; }
