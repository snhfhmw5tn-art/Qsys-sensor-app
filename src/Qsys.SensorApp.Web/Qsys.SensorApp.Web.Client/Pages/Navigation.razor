@page "/navigation"
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.JSInterop
@using Qsys.SensorApp.Core.DigitalTwin
@using Qsys.SensorApp.Core.Geometry
@using Qsys.SensorApp.Core.Maps
@using Qsys.SensorApp.Core.Navigation
@using Qsys.SensorApp.Core.Sensors
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Digital Twin | Qsys Sensor App</PageTitle>
<section class="page-heading"><p class="eyebrow">MILESTONE 10 · WAREHOUSE DIGITAL TWIN</p><h1>Digital Twin</h1><p class="lede">Live warehouse position, movement history, replay, visit heatmap and activity intelligence.</p></section>

<section class="sensor-controls">
    <div class="sensor-control-copy"><strong>@(isRunning ? "Navigation session active" : "Navigation session stopped")</strong><span>@mapMessage</span></div>
    <label>Start X (m) <input type="number" step="0.1" @bind="initialX" disabled="@isRunning" /></label>
    <label>Start Y (m) <input type="number" step="0.1" @bind="initialY" disabled="@isRunning" /></label>
    <label>Heading (°) <input type="number" step="1" @bind="initialHeading" disabled="@isRunning" /></label>
    <label>Step length (m) <input type="number" min="0.2" max="1.5" step="0.01" @bind="stepLength" disabled="@isRunning" /></label>
    @if (isRunning)
    {
        <button class="quiet-button" @onclick="SetTravelDirectionToZero" disabled="@(DisplayBearing is null || viewMode != TwinViewMode.Live)">Set travel direction to 0°</button>
    }
    @if (isRunning) { <button class="quiet-button" @onclick="StopNavigation">Stop session</button> }
    else { <button class="primary-link" @onclick="StartNavigation">Start navigation</button> }
</section>
<p class="small-note">The red line shows the direction of movement based on the recorded position track. Phone orientation does not rotate the displayed travel direction.</p>
@if (!string.IsNullOrWhiteSpace(message)) { <p class="small-note">@message</p> }

<section class="twin-controls">
    <label>View <select @bind="viewMode" @bind:after="OnViewModeChanged"><option value="Live">Live position</option><option value="Heatmap">Heatmap</option><option value="Replay">History replay</option></select></label>
    @if (viewMode == TwinViewMode.Replay)
    {
        <label class="replay-range">History <input type="range" min="0" max="@Math.Max(0, twinHistory.Count - 1)" value="@replayIndex" @oninput="ChangeReplayIndex" disabled="@(twinHistory.Count == 0)" /></label>
        <span>@ReplayTimestamp</span>
        <button class="quiet-button" @onclick="ToggleReplay" disabled="@(twinHistory.Count < 2)">@(isReplayPlaying ? "Pause replay" : "Play replay")</button>
    }
    @if (viewMode == TwinViewMode.Heatmap) { <span>@heatmapCells.Count hot cells · 2 m grid</span> }
    <button class="quiet-button" @onclick="ClearHistory" disabled="@(isRunning || twinHistory.Count == 0)">Clear local history</button>
</section>

<section class="about-panel navigation-stats">
    <div><span class="eyebrow">POSITION · X / Y / Z</span><p>@DisplayPosition.X.ToString("0.00") / @DisplayPosition.Y.ToString("0.00") / @DisplayPosition.Z.ToString("0.00") m</p></div>
    <div><span class="eyebrow">TRAVEL DIRECTION · RED</span><p>@(DisplayBearing?.ToString("0.0") ?? "—")°</p><small>Direction derived from the position track</small></div>
    <div><span class="eyebrow">DRAWN DISTANCE</span><p>@DrawnDistanceMeters.ToString("0.00") m</p><small>Accumulated length of the displayed track</small></div>
    <div><span class="eyebrow">ELEVATION CHANGE · BAROMETER</span><p>@ElevationDisplay</p><small>@ElevationDetail</small></div>
    <div><span class="eyebrow">SPEED · STEPS</span><p>@(ReplaySample?.SpeedMetersPerSecond.ToString("0.00") ?? state.SpeedMetersPerSecond.ToString("0.00")) m/s · @(ReplaySample?.StepCount ?? state.StepCount)</p></div>
    <div><span class="eyebrow">ACTIVITY · CONFIDENCE</span><p>@(ReplaySample is { } replay ? replay.Activity : state.Activity.Type) · @ReplayActivityConfidence.ToString("0")%</p></div>
    <div><span class="eyebrow">CONFIDENCE · UNCERTAINTY</span><p>@((ReplaySample?.Confidence ?? state.Confidence).ToString("P0")) · ±@((ReplaySample?.PositionUncertaintyMeters ?? state.PositionUncertaintyMeters).ToString("0.00")) m</p></div>
    <div><span class="eyebrow">HISTORY · SESSIONS</span><p>@twinHistory.Count.ToString("N0") samples · @twinHistory.Select(sample => sample.SessionId).Distinct().Count() sessions</p></div>
</section>
<section class="about-panel twin-insights"><div><span class="eyebrow">MOVEMENT INTELLIGENCE · RULE-BASED</span><p>@TopActivityInsight</p></div><div><span class="eyebrow">MEAN ACTIVITY CONFIDENCE</span><p>@MeanActivityConfidence</p></div><div><span class="eyebrow">HEATMAP TOTAL</span><p>@twinHistory.Count visits recorded locally</p></div></section>
<p class="small-note">Activity labels use the explainable sensor heuristic from Milestone 7; this view does not call an external or trained AI model. Truck remains a low-confidence vibration candidate.</p>

<section class="navigation-empty navigation-map">
    <svg viewBox="@MapViewBox()" role="img" aria-label="Local navigation position and map graph">
        <g class="nav-graph">
            @foreach (var edge in graph.Edges)
            {
                var from = graph.Nodes.First(node => node.Id == edge.FromNodeId).Position;
                var to = graph.Nodes.First(node => node.Id == edge.ToNodeId).Position;
                <line x1="@N(from.X)" y1="@N(-from.Y)" x2="@N(to.X)" y2="@N(-to.Y)" />
            }
        </g>
        @if (viewMode == TwinViewMode.Heatmap)
        {
            @foreach (var cell in heatmapCells)
            {
                <circle class="heat-cell" cx="@N(cell.CenterX)" cy="@N(-cell.CenterY)" r="0.75" fill-opacity="@N(0.18 + cell.Intensity * 0.65)"><title>@cell.SampleCount visits</title></circle>
            }
        }
        @if (viewMode != TwinViewMode.Heatmap) { <path class="nav-track" d="@DisplayedTrackPath()" /> }
        @if (viewMode != TwinViewMode.Heatmap)
        {
            @foreach (var marker in DistanceMarkers())
            {
                <circle class="nav-distance-marker" cx="@N(marker.X)" cy="@N(-marker.Y)" r="0.07"><title>Every 1 m</title></circle>
            }
        }
        <circle class="nav-position" cx="@N(DisplayPosition.X)" cy="@N(-DisplayPosition.Y)" r="0.22" />
        <text class="nav-distance-label" x="@N(DisplayPosition.X + 0.32)" y="@N(-DisplayPosition.Y - 0.22)" dominant-baseline="middle">@DrawnDistanceMeters.ToString("0.0") m</text>
        @if (DisplayBearing is { } bearing)
        {
            var angle = bearing * Math.PI / 180;
            <line class="nav-heading" x1="@N(DisplayPosition.X)" y1="@N(-DisplayPosition.Y)" x2="@N(DisplayPosition.X + Math.Sin(angle))" y2="@N(-DisplayPosition.Y - Math.Cos(angle))" />
        }
    </svg>
    <div class="navigation-map-legend"><span><i class="legend-device"></i>Red: travel direction</span></div>
    <p>@(viewMode == TwinViewMode.Heatmap ? "Warmer cells indicate more recorded position samples. Data is stored in this browser only." : viewMode == TwinViewMode.Replay ? "Replay is selected from this browser's recorded local history." : "Position uses a local metre-based frame. Bearing 0° points north; east is +X. Travel direction appears after movement.")</p>
</section>

@code {
    private IJSObjectReference? sensorModule;
    private IJSObjectReference? drawingModule;
    private DotNetObjectReference<Navigation>? dotnetReference;
    private DeadReckoningEngine? engine;
    private NavigationGraph graph = new([], []);
    private NavigationState state = new(DateTimeOffset.UtcNow, Vector3.Zero, null, 0, 0, 0, 0, false, null, ActivityEstimate.Unknown);
    private readonly List<Vector2> track = [];
    private readonly List<DigitalTwinSample> twinHistory = [];
    private readonly List<HeatmapCell> heatmapCells = [];
    private static readonly JsonSerializerOptions HistoryJsonOptions = new(JsonSerializerDefaults.Web) { Converters = { new JsonStringEnumConverter(JsonNamingPolicy.CamelCase) } };
    private TwinViewMode viewMode = TwinViewMode.Live;
    private Guid currentSessionId;
    private DateTimeOffset? lastHistoryCapture;
    private int replayIndex;
    private CancellationTokenSource? replayCancellation;
    private bool isReplayPlaying;
    private bool isDisposed;
    private bool isRunning;
    private bool hasAltitudeReading;
    private double minimumElevation;
    private double maximumElevation;
    private double initialX;
    private double initialY;
    private double initialHeading;
    private double? travelDirectionOffsetDegrees;
    private double stepLength = 0.72;
    private string mapMessage = "Loading saved map…";
    private string? message;
    private DateTime lastUiUpdate = DateTime.MinValue;

    private enum TwinViewMode { Live, Heatmap, Replay }
    private const int MaximumHistorySamples = 5000;
    private DigitalTwinSample? ReplaySample => viewMode == TwinViewMode.Replay && twinHistory.Count > 0 ? twinHistory[Math.Clamp(replayIndex, 0, twinHistory.Count - 1)] : null;
    private Vector2[] DisplayedTrackPoints => viewMode == TwinViewMode.Replay && ReplaySample is { } replay
        ? twinHistory.Take(replayIndex + 1).Where(sample => sample.SessionId == replay.SessionId).Select(sample => new Vector2(sample.X, sample.Y)).ToArray()
        : track.ToArray();
    private double DrawnDistanceMeters => GetPathLength(DisplayedTrackPoints);
    private Vector3 DisplayPosition => ReplaySample is { } sample ? new Vector3(sample.X, sample.Y, sample.Z) : state.PositionMeters;
    private bool turningWithoutTranslation;
    private double? DisplayBearing => HasConfirmedMovement
        ? AdjustBearing(GetDisplayedBearing(), travelDirectionOffsetDegrees)
        : null;
    // Heading changes alone do not prove walking; require cadence, speed and walking activity to avoid drawing while turning in place.
    private bool HasConfirmedMovement => ReplaySample is { } sample
        ? IsMoving(sample.SpeedMetersPerSecond, sample.StepCount, sample.Activity)
        : !turningWithoutTranslation && IsMoving(state.SpeedMetersPerSecond, state.StepCount, state.Activity.Type);
    private string ElevationDisplay => ReplaySample is { } sample
        ? $"{sample.Z.ToString("+0.00;-0.00;0.00", System.Globalization.CultureInfo.InvariantCulture)} m"
        : hasAltitudeReading ? $"{state.PositionMeters.Z.ToString("+0.00;-0.00;0.00", System.Globalization.CultureInfo.InvariantCulture)} m" : "Unavailable";
    private string ElevationDetail => ReplaySample is not null
        ? "Relative to the session’s first barometer reading"
        : hasAltitudeReading ? $"Session range: {minimumElevation:0.00} to {maximumElevation:0.00} m" : "Requires a device barometer; 0.00 m is not assumed when unavailable.";
    private double ReplayActivityConfidence => (ReplaySample?.ActivityConfidence ?? state.Activity.Confidence) * 100;
    private double? GetDisplayedBearing()
    {
        if (viewMode == TwinViewMode.Replay && ReplaySample is { } replay)
        {
            for (var index = Math.Min(replayIndex - 1, twinHistory.Count - 1); index >= 0; index--)
            {
                var previous = twinHistory[index];
                if (previous.SessionId != replay.SessionId) continue;
                var deltaX = replay.X - previous.X;
                var deltaY = replay.Y - previous.Y;
                if ((deltaX * deltaX) + (deltaY * deltaY) < 0.0025) continue;
                return NormalizeBearing(Math.Atan2(deltaX, deltaY) * 180 / Math.PI);
            }
            return null;
        }

        for (var index = track.Count - 2; index >= 0; index--)
        {
            var deltaX = track[^1].X - track[index].X;
            var deltaY = track[^1].Y - track[index].Y;
            if ((deltaX * deltaX) + (deltaY * deltaY) < 0.0025) continue;
            return NormalizeBearing(Math.Atan2(deltaX, deltaY) * 180 / Math.PI);
        }
        return null;
    }

    private static double NormalizeBearing(double degrees) => ((degrees % 360) + 360) % 360;
    private static bool IsMoving(double speed, int stepCount, ActivityType activity) =>
        speed >= 0.15 && stepCount >= 2 && activity is ActivityType.Walking or ActivityType.Running or ActivityType.Stairs;

    private static double? AdjustBearing(double? bearing, double? offset) => bearing is { } value
        ? NormalizeBearing(value - (offset ?? 0))
        : null;

    private static double GetPathLength(IReadOnlyList<Vector2> points)
    {
        var length = 0d;
        for (var index = 1; index < points.Count; index++)
        {
            var segmentLength = (points[index] - points[index - 1]).Length;
            if (segmentLength >= 0.02) length += segmentLength;
        }
        return length;
    }

    private IEnumerable<Vector2> DistanceMarkers()
    {
        var points = DisplayedTrackPoints;
        var distanceAlongPath = 0d;
        var nextMarkerDistance = 1d;
        for (var index = 1; index < points.Length; index++)
        {
            var start = points[index - 1];
            var segment = points[index] - start;
            var segmentLength = segment.Length;
            if (segmentLength < 0.02) continue;
            while (nextMarkerDistance <= distanceAlongPath + segmentLength)
            {
                var fraction = (nextMarkerDistance - distanceAlongPath) / segmentLength;
                yield return start + (segment * fraction);
                nextMarkerDistance += 1d;
            }
            distanceAlongPath += segmentLength;
        }
    }
    private string ReplayTimestamp => ReplaySample is { } sample ? sample.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") : "No history";
    private string TopActivityInsight
    {
        get
        {
            if (twinHistory.Count == 0) return "No captured movement samples yet.";
            var group = twinHistory.GroupBy(sample => sample.Activity).OrderByDescending(item => item.Count()).First();
            return $"Most observed label: {group.Key} ({group.Count()} of {twinHistory.Count} samples).";
        }
    }
    private string MeanActivityConfidence => twinHistory.Count == 0 ? "—" : $"{twinHistory.Average(sample => sample.ActivityConfidence):P0}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            sensorModule = await JS.InvokeAsync<IJSObjectReference>("import", "./sensors.js");
            drawingModule = await JS.InvokeAsync<IJSObjectReference>("import", "./drawing.js");
            var storedHistory = await drawingModule.InvokeAsync<JsonElement>("loadDigitalTwinHistory");
            if (storedHistory.ValueKind == JsonValueKind.Array)
            {
                try
                {
                    var loaded = JsonSerializer.Deserialize<List<DigitalTwinSample>>(storedHistory.GetRawText(), HistoryJsonOptions) ?? [];
                    twinHistory.AddRange(loaded.Where(IsValidSample).TakeLast(MaximumHistorySamples));
                    heatmapCells.AddRange(HeatmapAggregator.Aggregate(twinHistory));
                    replayIndex = Math.Max(0, twinHistory.Count - 1);
                }
                catch (Exception exception) when (exception is JsonException or InvalidOperationException or ArgumentException)
                {
                    message = "Saved digital-twin history could not be read; new samples can still be recorded.";
                }
            }
            var saved = await drawingModule.InvokeAsync<JsonElement>("loadMap");
            var features = ReadFeatures(saved);
            var sourceGraph = NavigationGraphGenerator.Generate(features);
            var scale = saved.ValueKind == JsonValueKind.Object && saved.TryGetProperty("metersPerDrawingUnit", out var scaleValue) && scaleValue.ValueKind == JsonValueKind.Number && scaleValue.TryGetDouble(out var parsedScale) && double.IsFinite(parsedScale) && parsedScale > 0 ? parsedScale : 0;
            if (scale > 0 && sourceGraph.Edges.Count > 0)
            {
                graph = new NavigationGraph(sourceGraph.Nodes.Select(node => node with { Position = new Vector2(node.Position.X * scale, -node.Position.Y * scale) }),
                    sourceGraph.Edges.Select(edge => edge with { Length = edge.Length * scale }));
                mapMessage = $"Calibrated map loaded · {graph.Edges.Count} graph segments · local storage";
            }
            else mapMessage = features.Count == 0 ? "No map features saved. Dead reckoning works without map matching; draw and calibrate a map first." : "Map features loaded, but scale calibration is needed to enable map matching.";
        }
        catch (Exception exception) when (exception is JSException or JsonException or InvalidOperationException or ArgumentException)
        {
            mapMessage = "Saved browser data could not be loaded. Clear or repair the saved map/history, then reload the page.";
            message = $"Digital Twin startup problem: {exception.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    private static List<WarehouseFeature> ReadFeatures(JsonElement saved)
    {
        var features = new List<WarehouseFeature>();
        if (saved.ValueKind != JsonValueKind.Object || !saved.TryGetProperty("features", out var items) || items.ValueKind != JsonValueKind.Array) return features;
        foreach (var item in items.EnumerateArray())
        {
            if (item.ValueKind != JsonValueKind.Object || !item.TryGetProperty("kind", out var kindValue) || kindValue.ValueKind != JsonValueKind.String || !Enum.TryParse<WarehouseFeatureKind>(kindValue.GetString(), true, out var kind) || !Enum.IsDefined(kind)) continue;
            if (!item.TryGetProperty("points", out var pointValues) || pointValues.ValueKind != JsonValueKind.Array) continue;
            var points = new List<Vector2>();
            var validPoints = true;
            foreach (var point in pointValues.EnumerateArray())
            {
                if (point.ValueKind != JsonValueKind.Object || !point.TryGetProperty("x", out var xValue) || xValue.ValueKind != JsonValueKind.Number || !xValue.TryGetDouble(out var x) ||
                    !point.TryGetProperty("y", out var yValue) || yValue.ValueKind != JsonValueKind.Number || !yValue.TryGetDouble(out var y) || !double.IsFinite(x) || !double.IsFinite(y))
                {
                    validPoints = false;
                    break;
                }
                points.Add(new Vector2(x, y));
            }
            if (!validPoints) continue;
            var id = item.TryGetProperty("id", out var idValue) && idValue.ValueKind == JsonValueKind.String && Guid.TryParse(idValue.GetString(), out var parsedId) ? parsedId : Guid.NewGuid();
            if (id == Guid.Empty) id = Guid.NewGuid();
            var name = item.TryGetProperty("name", out var nameValue) && nameValue.ValueKind == JsonValueKind.String ? nameValue.GetString() : null;
            var level = item.TryGetProperty("level", out var levelValue) && levelValue.ValueKind == JsonValueKind.String ? levelValue.GetString() : null;
            try { features.Add(new WarehouseFeature(id, kind, string.IsNullOrWhiteSpace(name) ? kind.ToString() : name, points, string.IsNullOrWhiteSpace(level) ? "0" : level)); }
            catch (ArgumentException) { }
        }
        return features;
    }

    private async Task StartNavigation()
    {
        if (sensorModule is null) return;
        message = null;
        try
        {
            engine = new DeadReckoningEngine(new Vector3(initialX, initialY, 0), stepLength, initialHeading, graph.Edges.Count == 0 ? null : graph);
            turningWithoutTranslation = false;
            travelDirectionOffsetDegrees = null;
            hasAltitudeReading = false;
            minimumElevation = maximumElevation = 0;
            state = engine.State;
            viewMode = TwinViewMode.Live;
            currentSessionId = Guid.NewGuid();
            lastHistoryCapture = null;
            track.Clear(); track.Add(new Vector2(state.PositionMeters.X, state.PositionMeters.Y));
            dotnetReference?.Dispose(); dotnetReference = DotNetObjectReference.Create(this);
            using var result = await sensorModule.InvokeAsync<JsonDocument>("start", dotnetReference, 25);
            isRunning = true;
            message = "Sensor session requested at up to 25 Hz. Availability depends on browser, permissions and device hardware.";
        }
        catch (Exception exception) when (exception is JSException or ArgumentException)
        {
            isRunning = false; message = exception.Message;
        }
    }

    private void SetTravelDirectionToZero()
    {
        if (DisplayBearing is null || GetDisplayedBearing() is not { } rawBearing) return;
        // Rebase only the displayed walking direction. The observed path and sensor heading stay untouched.
        travelDirectionOffsetDegrees = rawBearing;
        message = "Travel direction set to 0°.";
    }

    private async Task StopNavigation()
    {
        if (sensorModule is not null) await sensorModule.InvokeVoidAsync("stop");
        isRunning = false; message = "Navigation stopped. The final estimate remains visible until this page is closed.";
    }

    [JSInvokable]
    public async Task OnSensorReading(JsonElement sample)
    {
        if (engine is null) return;
        try
        {
            var millis = Number(sample, "timestampUnixMilliseconds") ?? DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            var timestamp = DateTimeOffset.FromUnixTimeMilliseconds((long)millis);
            var rotationRate = Vector(sample, "rotationRate");
            var gravity = Vector(sample, "accelerationIncludingGravity");
            var linearAcceleration = Vector(sample, "acceleration");
            var reading = new SensorReading(timestamp, Number(sample, "samplingIntervalMilliseconds") ?? 0,
                linearAcceleration, gravity, rotationRate, Vector(sample, "magneticField"),
                Number(sample, "headingDegrees"), Number(sample, "pitchDegrees"), Number(sample, "rollDegrees"), Boolean(sample, "orientationIsAbsolute"), Number(sample, "pressureKilopascals"));
            // Use the same spatial-motion decision as the step detector so the travel indicator stays hidden while turning in place.
            turningWithoutTranslation = StepDetector.IsTurningWithoutTranslation(reading);
            state = engine.Process(reading);
            if (reading.PressureKilopascals is > 0)
            {
                hasAltitudeReading = true;
                minimumElevation = Math.Min(minimumElevation, state.PositionMeters.Z);
                maximumElevation = Math.Max(maximumElevation, state.PositionMeters.Z);
            }
            track.Add(new Vector2(state.PositionMeters.X, state.PositionMeters.Y));
            if (track.Count > 600) track.RemoveAt(0);
            if (lastHistoryCapture is null || (state.TimestampUtc - lastHistoryCapture.Value).TotalSeconds >= 1)
                await CaptureHistorySample();
            if ((DateTime.UtcNow - lastUiUpdate).TotalMilliseconds >= 100)
            {
                lastUiUpdate = DateTime.UtcNow;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (ArgumentException exception) { message = exception.Message; await InvokeAsync(StateHasChanged); }
    }

    [JSInvokable]
    public async Task OnSensorDiagnostic(JsonElement diagnostic)
    {
        var kind = diagnostic.TryGetProperty("kind", out var kindValue) ? kindValue.GetString() ?? "Sensor" : "Sensor";
        var detail = diagnostic.TryGetProperty("message", out var messageValue) ? messageValue.GetString() ?? "Unknown sensor error." : "Unknown sensor error.";
        message = $"{kind}: {detail}";
        await InvokeAsync(StateHasChanged);
    }

    private string TrackPath() => track.Count < 2 ? string.Empty : string.Join(" ", track.Select((point, index) => $"{(index == 0 ? "M" : "L")}{N(point.X)},{N(-point.Y)}"));
    private string DisplayedTrackPath()
    {
        if (viewMode != TwinViewMode.Replay || ReplaySample is not { } replay) return TrackPath();
        var points = twinHistory.Take(replayIndex + 1).Where(sample => sample.SessionId == replay.SessionId).Select(sample => new Vector2(sample.X, sample.Y)).ToArray();
        return points.Length < 2 ? string.Empty : string.Join(" ", points.Select((point, index) => $"{(index == 0 ? "M" : "L")}{N(point.X)},{N(-point.Y)}"));
    }

    private async Task CaptureHistorySample()
    {
        lastHistoryCapture = state.TimestampUtc;
        var sample = new DigitalTwinSample(currentSessionId, state.TimestampUtc, state.PositionMeters.X, state.PositionMeters.Y, state.PositionMeters.Z,
            state.HeadingDegrees, state.SpeedMetersPerSecond, state.StepCount, state.Confidence, state.PositionUncertaintyMeters, state.Activity.Type, state.Activity.Confidence);
        twinHistory.Add(sample);
        if (twinHistory.Count > MaximumHistorySamples) twinHistory.RemoveAt(0);
        heatmapCells.Clear(); heatmapCells.AddRange(HeatmapAggregator.Aggregate(twinHistory));
        if (drawingModule is not null)
        {
            var saved = await drawingModule.InvokeAsync<bool>("appendDigitalTwinSample", new
            {
                sessionId = sample.SessionId, timestampUtc = sample.TimestampUtc, sample.X, sample.Y, sample.Z, sample.HeadingDegrees, sample.DeviceForwardHeadingDegrees,
                sample.DeviceScreenOrientationDegrees,
                sample.SpeedMetersPerSecond, sample.StepCount, sample.Confidence, sample.PositionUncertaintyMeters,
                activity = sample.Activity.ToString(), sample.ActivityConfidence
            });
            if (!saved) message = "Twin history is visible in this session but could not be saved to browser storage.";
        }
        if (viewMode == TwinViewMode.Replay) replayIndex = Math.Max(0, twinHistory.Count - 1);
    }

    private static bool IsValidSample(DigitalTwinSample sample) => sample is not null && sample.SessionId != Guid.Empty && double.IsFinite(sample.X) && double.IsFinite(sample.Y) && double.IsFinite(sample.Z) &&
        double.IsFinite(sample.SpeedMetersPerSecond) && sample.SpeedMetersPerSecond >= 0 && sample.StepCount >= 0 &&
        double.IsFinite(sample.Confidence) && sample.Confidence is >= 0 and <= 1 && double.IsFinite(sample.PositionUncertaintyMeters) && sample.PositionUncertaintyMeters >= 0 &&
        double.IsFinite(sample.ActivityConfidence) && sample.ActivityConfidence is >= 0 and <= 1 &&
        (sample.HeadingDegrees is null || double.IsFinite(sample.HeadingDegrees.Value)) &&
        (sample.DeviceForwardHeadingDegrees is null || double.IsFinite(sample.DeviceForwardHeadingDegrees.Value)) &&
        (sample.DeviceScreenOrientationDegrees is null || double.IsFinite(sample.DeviceScreenOrientationDegrees.Value)) && Enum.IsDefined(sample.Activity);

    private async Task OnViewModeChanged()
    {
        if (viewMode == TwinViewMode.Replay) replayIndex = Math.Max(0, twinHistory.Count - 1);
        else StopReplay();
        await InvokeAsync(StateHasChanged);
    }

    private void ChangeReplayIndex(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var index)) replayIndex = Math.Clamp(index, 0, Math.Max(0, twinHistory.Count - 1));
    }

    private Task ToggleReplay()
    {
        if (isReplayPlaying) { StopReplay(); return Task.CompletedTask; }
        if (twinHistory.Count < 2) return Task.CompletedTask;
        viewMode = TwinViewMode.Replay;
        if (replayIndex >= twinHistory.Count - 1) replayIndex = 0;
        replayCancellation = new CancellationTokenSource();
        isReplayPlaying = true;
        _ = RunReplay(replayCancellation.Token);
        return Task.CompletedTask;
    }

    private async Task RunReplay(CancellationToken cancellationToken)
    {
        try
        {
            while (true)
            {
                await Task.Delay(500, cancellationToken);
                replayIndex = replayIndex >= twinHistory.Count - 1 ? 0 : replayIndex + 1;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        finally
        {
            isReplayPlaying = false;
            if (!isDisposed)
            {
                try { await InvokeAsync(StateHasChanged); }
                catch (InvalidOperationException) { }
            }
        }
    }

    private void StopReplay()
    {
        replayCancellation?.Cancel();
        replayCancellation?.Dispose();
        replayCancellation = null;
        isReplayPlaying = false;
    }

    private async Task ClearHistory()
    {
        StopReplay();
        if (drawingModule is not null) await drawingModule.InvokeVoidAsync("clearDigitalTwinHistory");
        twinHistory.Clear(); heatmapCells.Clear(); replayIndex = 0;
        message = "Local digital-twin history and heatmap cleared.";
    }

    private string MapViewBox()
    {
        IEnumerable<Vector2> points = graph.Nodes.Select(node => node.Position);
        if (viewMode == TwinViewMode.Live)
        {
            // A fresh session has a fresh track. Old sessions must not keep the live canvas zoomed out.
            points = points.Concat(track);
        }
        else if (viewMode == TwinViewMode.Heatmap)
        {
            points = points.Concat(twinHistory.Select(sample => new Vector2(sample.X, sample.Y)))
                .Concat(heatmapCells.Select(cell => new Vector2(cell.CenterX, cell.CenterY)));
        }
        else if (ReplaySample is { } replay)
        {
            points = points.Concat(twinHistory.Take(replayIndex + 1).Where(sample => sample.SessionId == replay.SessionId)
                .Select(sample => new Vector2(sample.X, sample.Y)));
        }
        var visiblePoints = points.Append(new Vector2(DisplayPosition.X, DisplayPosition.Y)).ToArray();
        var minX = visiblePoints.Min(point => point.X); var maxX = visiblePoints.Max(point => point.X);
        var minY = visiblePoints.Min(point => -point.Y); var maxY = visiblePoints.Max(point => -point.Y);
        var padding = Math.Max(2, Math.Max(maxX - minX, maxY - minY) * 0.12);
        var width = Math.Max(4, maxX - minX + 2 * padding); var height = Math.Max(4, maxY - minY + 2 * padding);
        return $"{N((minX + maxX - width) / 2)} {N((minY + maxY - height) / 2)} {N(width)} {N(height)}";
    }
    private static string N(double value) => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private static double? Number(JsonElement sample, string key) => sample.TryGetProperty(key, out var property) && property.ValueKind == JsonValueKind.Number && property.TryGetDouble(out var number) && double.IsFinite(number) ? number : null;
    private static bool Boolean(JsonElement sample, string key) => sample.TryGetProperty(key, out var property) && property.ValueKind == JsonValueKind.True;
    private static SensorVector3? Vector(JsonElement sample, string prefix)
    {
        var x = Number(sample, $"{prefix}X"); var y = Number(sample, $"{prefix}Y"); var z = Number(sample, $"{prefix}Z");
        return x is null || y is null || z is null ? null : new SensorVector3(x.Value, y.Value, z.Value);
    }

    public async ValueTask DisposeAsync()
    {
        isDisposed = true;
        StopReplay();
        if (sensorModule is not null) { try { await sensorModule.InvokeVoidAsync("stop"); } catch (JSDisconnectedException) { } await sensorModule.DisposeAsync(); }
        if (drawingModule is not null) await drawingModule.DisposeAsync();
        dotnetReference?.Dispose();
    }
}
