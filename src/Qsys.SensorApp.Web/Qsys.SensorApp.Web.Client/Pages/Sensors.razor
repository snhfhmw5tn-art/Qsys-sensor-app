@page "/sensors"
@using System.Text.Json
@using System.Globalization
@using Qsys.SensorApp.Core.Navigation
@using Qsys.SensorApp.Core.Sensors
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Sensors | Qsys Sensor App</PageTitle>
<section class="page-heading"><p class="eyebrow">MILESTONE 5 · SENSOR ENGINE</p><h1>Sensors</h1><p class="lede">Live device measurements, access permissions and sampling diagnostics.</p></section>

<section class="sensor-controls">
    <div class="sensor-control-copy">
        <strong>@(SamplingStatus)</strong>
        <span>@(isSecureContext ? "Secure context · browser and device support varies" : "HTTPS or localhost is required to access device sensors")</span>
    </div>
    <label>Sampling rate <select @bind="requestedRateHz" disabled="@isSampling"><option value="1">1 Hz</option><option value="5">5 Hz</option><option value="10">10 Hz</option><option value="20">20 Hz</option><option value="25">25 Hz</option></select></label>
    @if (!isSampling) { <button class="primary-link sensor-start" @onclick="StartSampling" disabled="@(drawingModule is null)">Allow sensors and start</button> }
    else { <button class="quiet-button" @onclick="StopSampling">Stop sampling</button> }
</section>
@if (!string.IsNullOrWhiteSpace(message)) { <p class="sensor-message" role="status">@message</p> }

<section class="sensor-grid">
    @foreach (var capability in capabilities)
    {
        <article class="sensor-card">
            <span class="sensor-symbol">@Icon(capability.Kind)</span>
            <div><strong>@capability.Kind</strong><span>@Description(capability.Kind)</span>
                <small>Permission: @capability.Permission</small>
                @if (!string.IsNullOrWhiteSpace(capability.Diagnostic)) { <small class="sensor-warning">@capability.Diagnostic</small> }
            </div>
            <span class="pill @(capability.IsSupported ? "" : "neutral")">@(capability.IsSupported ? "API available" : "Unavailable")</span>
        </article>
    }
    @if (capabilities.Count == 0) { <article class="sensor-card"><div><strong>Checking browser capabilities…</strong><span>Capabilities are checked without requesting permission.</span></div></article> }
</section>

<section class="sensor-diagnostics">
    <div class="sensor-section-heading"><div><p class="eyebrow">LIVE STREAM</p><h2>Latest readings</h2></div><span class="pill @((isSampling && receivedSamples > 0) ? "" : "neutral")">@SamplingBadge</span></div>
    @if (latestReading is null)
    {
        <p class="small-note">@(isSampling ? "Waiting for readings from the device. Browser API availability does not guarantee that this device has a connected sensor." : "Start sampling to view sensor values. Permissions are requested only after you press the start button.")</p>
    }
    else
    {
        <div class="reading-grid">
            <article><span>Acceleration · m/s²</span><strong>@Vector(latestReading.Acceleration)</strong><small>Including gravity: @Vector(latestReading.AccelerationIncludingGravity)</small></article>
            <article><span>Rotation rate · °/s</span><strong>@Vector(latestReading.RotationRateDegreesPerSecond)</strong><small>Heading: @Scalar(latestReading.HeadingDegrees, "°") · @(latestReading.OrientationIsAbsolute ? "absolute" : "relative / unavailable")</small></article>
            <article><span>Orientation · live</span><strong>Heading @Scalar(latestReading.HeadingDegrees, "°")</strong><small>Pitch @Scalar(latestReading.PitchDegrees, "°") · Roll @Scalar(latestReading.RollDegrees, "°") · @(latestReading.OrientationIsAbsolute ? "absolute" : "relative")</small></article>
            <article><span>DeviceMotion · live</span><strong>Linear @Vector(latestReading.Acceleration)</strong><small>Gravity @Vector(latestReading.AccelerationIncludingGravity) · Rotation @Vector(latestReading.RotationRateDegreesPerSecond) °/s</small></article>
            <article><span>Magnetic field · μT</span><strong>@Vector(latestReading.MagneticFieldMicrotesla)</strong><small>Pitch @Scalar(latestReading.PitchDegrees, "°") · Roll @Scalar(latestReading.RollDegrees, "°")</small></article>
            <article><span>Barometer · kPa</span><strong>@Scalar(latestReading.PressureKilopascals, " kPa")</strong><small>Device timestamp: @latestReading.TimestampUtc.ToLocalTime().ToString("HH:mm:ss.fff")</small></article>
        </div>
    }
</section>

<section class="sensor-diagnostics vibration-panel">
    <div class="sensor-section-heading"><div><p class="eyebrow">LIVE VIBRATION · EXPERIMENTAL</p><h2>Dominant frequency over time</h2></div><span class="vibration-class @ActivityClassCss">@CurrentVibrationClass · @Scalar(currentVibrationFrequencyHz, " Hz")</span></div>
    <p class="small-note">Frequency is estimated from a rolling 4-second accelerometer window. A high frequency alone never marks walking, running or truck: the vibration RMS must also exceed the adjustable movement floor. Values between the stillness ceiling and movement floor are shown as unclassified jitter. Use 20 or 25 Hz sampling to inspect truck vibration; lower rates can miss higher frequencies. @VibrationSourceNote</p>
    <div class="vibration-chart-wrap">
        <svg class="vibration-chart" viewBox="0 0 820 330" role="img" aria-label="Live estimated vibration frequency in hertz over time">
            @if (thresholds.WalkingMinHz < chartMaximumHz) { <rect class="vibration-band band-walk" x="70" y="@YForFrequency(Math.Min(thresholds.WalkingMaxHz, chartMaximumHz))" width="730" height="@BandHeight(thresholds.WalkingMinHz, Math.Min(thresholds.WalkingMaxHz, chartMaximumHz))" /> }
            @if (thresholds.RunningMinHz < chartMaximumHz) { <rect class="vibration-band band-run" x="70" y="@YForFrequency(Math.Min(thresholds.RunningMaxHz, chartMaximumHz))" width="730" height="@BandHeight(thresholds.RunningMinHz, Math.Min(thresholds.RunningMaxHz, chartMaximumHz))" /> }
            @if (thresholds.TruckMinHz < chartMaximumHz) { <rect class="vibration-band band-truck" x="70" y="@YForFrequency(Math.Min(thresholds.TruckMaxHz, chartMaximumHz))" width="730" height="@BandHeight(thresholds.TruckMinHz, Math.Min(thresholds.TruckMaxHz, chartMaximumHz))" /> }
            @for (var hz = 0; hz <= (int)chartMaximumHz; hz += 2)
            {
                <line class="chart-gridline" x1="70" x2="800" y1="@YForFrequency(hz)" y2="@YForFrequency(hz)" />
                <foreignObject x="14" y="@AxisLabelY(hz)" width="48" height="18"><div xmlns="http://www.w3.org/1999/xhtml" class="chart-axis-label">@hz</div></foreignObject>
            }
            <line class="chart-axis" x1="70" y1="30" x2="70" y2="280" />
            <line class="chart-axis" x1="70" y1="280" x2="800" y2="280" />
            <path class="vibration-frequency-line" d="@VibrationFrequencyPath()" />
        </svg>
    </div>
    <div class="vibration-chart-legend"><span>Y: frequency 0–@chartMaximumHz.ToString("0.0") Hz</span><span>X: last @VibrationHistorySeconds seconds</span><span class="legend-walk">Walk @thresholds.WalkingMinHz–@thresholds.WalkingMaxHz Hz</span><span class="legend-run">Run @thresholds.RunningMinHz–@thresholds.RunningMaxHz Hz</span><span class="legend-truck">Truck @thresholds.TruckMinHz–@thresholds.TruckMaxHz Hz</span></div>
    <div class="vibration-current-values">
        <span>Vibration RMS <strong>@Scalar(currentVibrationRms, " m/s²")</strong></span>
        <span>Estimated sample rate <strong>@(observedRateHz?.ToString("0.0", CultureInfo.InvariantCulture) ?? "—") Hz</strong></span>
        <span>Frequency window <strong>4 s</strong></span>
        <span>Standing threshold <strong>≤ @thresholds.StandingRmsMaxMetersPerSecondSquared.ToString("0.00") m/s² RMS</strong></span>
    </div>
    <div class="vibration-thresholds">
        <div><label>Still / jitter RMS ceiling <input type="number" min="0.01" max="5" step="0.01" @bind="thresholds.StandingRmsMaxMetersPerSecondSquared" @bind:after="SaveThresholds" /> m/s²</label></div>
        <div><label>Minimum shake level for motion <input type="number" min="0.01" max="5" step="0.01" @bind="thresholds.ActiveRmsMinMetersPerSecondSquared" @bind:after="SaveThresholds" /> m/s²</label></div>
        <div class="threshold-group band-walk"><strong>Walking · Hz</strong><label>Min <input type="number" min="0.1" max="12.5" step="0.1" @bind="thresholds.WalkingMinHz" @bind:after="SaveThresholds" /></label><label>Max <input type="number" min="0.1" max="12.5" step="0.1" @bind="thresholds.WalkingMaxHz" @bind:after="SaveThresholds" /></label></div>
        <div class="threshold-group band-run"><strong>Running · Hz</strong><label>Min <input type="number" min="0.1" max="12.5" step="0.1" @bind="thresholds.RunningMinHz" @bind:after="SaveThresholds" /></label><label>Max <input type="number" min="0.1" max="12.5" step="0.1" @bind="thresholds.RunningMaxHz" @bind:after="SaveThresholds" /></label></div>
        <div class="threshold-group band-truck"><strong>Truck vibration · Hz</strong><label>Min <input type="number" min="0.1" max="12.5" step="0.1" @bind="thresholds.TruckMinHz" @bind:after="SaveThresholds" /></label><label>Max <input type="number" min="0.1" max="12.5" step="0.1" @bind="thresholds.TruckMaxHz" @bind:after="SaveThresholds" /></label></div>
        <button class="quiet-button" @onclick="ResetThresholds">Restore starting values</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(thresholdMessage)) { <p class="sensor-message" role="status">@thresholdMessage</p> }
</section>

<section class="sensor-diagnostics">
    <div class="sensor-section-heading"><div><p class="eyebrow">DIAGNOSTICS</p><h2>Sampling health</h2></div></div>
    <div class="diagnostic-grid">
        <div><span>Received samples</span><strong>@receivedSamples</strong></div>
        <div><span>Requested rate</span><strong>@requestedRateHz Hz</strong></div>
        <div><span>Observed rate</span><strong>@(observedRateHz is null ? "—" : $"{observedRateHz:0.0} Hz")</strong></div>
        <div><span>Dropped interop samples</span><strong>@droppedSamples</strong></div>
        <div><span>Sensor errors</span><strong>@sensorErrors.Count</strong></div>
        <div><span>Last reading</span><strong>@(latestReading is null ? "—" : latestReading.TimestampUtc.ToLocalTime().ToString("HH:mm:ss"))</strong></div>
    </div>
    @if (sensorErrors.Count > 0)
    {
        <ul class="sensor-error-list">@foreach (var error in sensorErrors.TakeLast(8)) { <li><strong>@error.Kind:</strong> @error.Message</li> }</ul>
    }
</section>

<section class="sensor-diagnostics">
    <div class="sensor-section-heading"><div><p class="eyebrow">RECENT HISTORY</p><h2>Last @recentReadings.Count samples</h2></div><button class="quiet-button" @onclick="ClearHistory" disabled="@(recentReadings.Count == 0)">Clear</button></div>
    @if (recentReadings.Count == 0) { <p class="small-note">Samples stay in this page's memory and are cleared when the page closes.</p> }
    else
    {
        <div class="reading-table-wrap"><table class="reading-table"><thead><tr><th>Time (UTC)</th><th>Accel X/Y/Z</th><th>Gyro X/Y/Z · °/s</th><th>Heading</th><th>Pressure · kPa</th></tr></thead><tbody>
            @foreach (var reading in recentReadings.Reverse()) { <tr><td>@reading.TimestampUtc.ToString("HH:mm:ss.fff")</td><td>@Vector(reading.Acceleration)</td><td>@Vector(reading.RotationRateDegreesPerSecond)</td><td>@Scalar(reading.HeadingDegrees, "°")</td><td>@Scalar(reading.PressureKilopascals, "")</td></tr> }
        </tbody></table></div>
    }
</section>

@code {
    private const int RecentReadingLimit = 300;
    private const int VibrationWindowSeconds = 4;
    private const int VibrationHistorySeconds = 20;
    private IJSObjectReference? drawingModule;
    private DotNetObjectReference<Sensors>? dotnetReference;
    private readonly List<SensorCapability> capabilities = [];
    private readonly List<SensorDiagnostic> sensorErrors = [];
    private readonly Queue<SensorReading> recentReadings = new();
    private readonly List<VibrationPoint> vibrationHistory = [];
    private SensorReading? latestReading;
    private VibrationThresholdSettings thresholds = new();
    private double? currentVibrationFrequencyHz;
    private double? currentVibrationRms;
    private double chartMaximumHz = 12.5;
    private DateTimeOffset? lastVibrationEstimate;
    private string? thresholdMessage;
    private int requestedRateHz = 10;
    private int receivedSamples;
    private int droppedSamples;
    private double? observedRateHz;
    private double? previousTimestampMilliseconds;
    private bool isSecureContext;
    private bool isSampling;
    private string? message;
    private DateTime lastUiUpdateUtc = DateTime.MinValue;
    private string SamplingStatus => !isSampling ? "Sensor sampling is stopped" : receivedSamples == 0 ? "Waiting for device readings" : "Sensor readings are arriving";
    private string SamplingBadge => !isSampling ? "Idle" : receivedSamples == 0 ? "Waiting" : "Receiving";

    private sealed record SensorDiagnostic(string Kind, string Message);
    private sealed record VibrationPoint(DateTimeOffset TimestampUtc, double FrequencyHz);
    private string CurrentVibrationClass => ClassifyVibration(currentVibrationFrequencyHz, currentVibrationRms, thresholds);
    private string ActivityClassCss => CurrentVibrationClass switch { "Standing" => "standing", "Walking-like" => "walking", "Running-like" => "running", "Truck-like vibration" => "truck", _ => "unknown" };
    private string VibrationSourceNote => latestReading?.Acceleration is null ? "Using acceleration including gravity; phone tilt can affect the estimate." : "Using gravity-compensated linear acceleration.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            drawingModule = await JS.InvokeAsync<IJSObjectReference>("import", "./sensors.js");
            var savedThresholds = await drawingModule.InvokeAsync<JsonElement>("loadVibrationThresholds");
            if (savedThresholds.ValueKind == JsonValueKind.Object)
            {
                try
                {
                    var loaded = JsonSerializer.Deserialize<VibrationThresholdSettings>(savedThresholds.GetRawText(), new JsonSerializerOptions(JsonSerializerDefaults.Web));
                    loaded?.Validate();
                    if (loaded is not null) thresholds = loaded;
                }
                catch (Exception exception) when (exception is JsonException or ArgumentException)
                {
                    thresholdMessage = "Saved thresholds were invalid; starting values are active.";
                }
            }
            await RefreshCapabilities();
        }
        catch (JSException exception) { message = $"Could not initialize browser sensors: {exception.Message}"; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshCapabilities()
    {
        if (drawingModule is null) return;
        using var result = await drawingModule.InvokeAsync<JsonDocument>("inspect");
        var root = result.RootElement;
        isSecureContext = root.GetProperty("secureContext").GetBoolean();
        capabilities.Clear();
        foreach (var sensor in root.GetProperty("sensors").EnumerateArray())
        {
            if (!Enum.TryParse<SensorKind>(sensor.GetProperty("kind").GetString(), out var kind)) continue;
            var permission = Enum.TryParse<SensorPermissionState>(sensor.GetProperty("permission").GetString(), out var parsedPermission)
                ? parsedPermission
                : SensorPermissionState.Unknown;
            capabilities.Add(new SensorCapability(
                kind,
                sensor.GetProperty("supported").GetBoolean(),
                permission,
                sensor.TryGetProperty("diagnostic", out var diagnostic) && diagnostic.ValueKind == JsonValueKind.String ? diagnostic.GetString() : null));
        }
    }

    private async Task StartSampling()
    {
        if (drawingModule is null) return;
        sensorErrors.Clear(); receivedSamples = 0; droppedSamples = 0; observedRateHz = null; previousTimestampMilliseconds = null;
        recentReadings.Clear(); vibrationHistory.Clear(); currentVibrationFrequencyHz = null; currentVibrationRms = null; lastVibrationEstimate = null;
        dotnetReference?.Dispose();
        dotnetReference = DotNetObjectReference.Create(this);
        try
        {
            using var result = await drawingModule.InvokeAsync<JsonDocument>("start", dotnetReference, requestedRateHz);
            isSampling = true;
            message = "Sensor access was requested. Waiting for device readings; browser API availability does not confirm physical sensor hardware.";
            await RefreshCapabilities();
        }
        catch (JSException exception)
        {
            isSampling = false;
            message = exception.Message;
        }
    }

    private async Task StopSampling()
    {
        if (drawingModule is not null) await drawingModule.InvokeVoidAsync("stop");
        isSampling = false;
        message = "Sampling stopped. Recent samples remain available until this page is closed or cleared.";
    }

    [JSInvokable]
    public async Task OnSensorReading(JsonElement sample)
    {
        try
        {
            var timestampMilliseconds = Number(sample, "timestampUnixMilliseconds") ?? DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            var timestamp = DateTimeOffset.FromUnixTimeMilliseconds((long)timestampMilliseconds);
            var reading = new SensorReading(
                timestamp,
                Number(sample, "samplingIntervalMilliseconds") ?? 0,
                Vector(sample, "acceleration"),
                Vector(sample, "accelerationIncludingGravity"),
                Vector(sample, "rotationRate"),
                Vector(sample, "magneticField"),
                Number(sample, "headingDegrees"),
                Number(sample, "pitchDegrees"),
                Number(sample, "rollDegrees"),
                Boolean(sample, "orientationIsAbsolute"),
                Number(sample, "pressureKilopascals"));

            if (previousTimestampMilliseconds is { } previous && timestampMilliseconds > previous)
            {
                var interval = timestampMilliseconds - previous;
                var currentRate = 1000 / interval;
                observedRateHz = observedRateHz is null ? currentRate : (observedRateHz.Value * 0.8) + (currentRate * 0.2);
            }
            previousTimestampMilliseconds = timestampMilliseconds;
            receivedSamples++;
            droppedSamples = Math.Max(droppedSamples, (int)(Number(sample, "droppedSamples") ?? 0));
            latestReading = reading;
            recentReadings.Enqueue(reading);
            while (recentReadings.Count > RecentReadingLimit) recentReadings.Dequeue();
            UpdateVibrationEstimate(reading);
            if ((DateTime.UtcNow - lastUiUpdateUtc).TotalMilliseconds >= 75)
            {
                lastUiUpdateUtc = DateTime.UtcNow;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (ArgumentException exception)
        {
            sensorErrors.Add(new SensorDiagnostic("Data", exception.Message));
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnSensorDiagnostic(JsonElement diagnostic)
    {
        var kind = diagnostic.TryGetProperty("kind", out var kindValue) ? kindValue.GetString() ?? "Sensor" : "Sensor";
        var text = diagnostic.TryGetProperty("message", out var messageValue) ? messageValue.GetString() ?? "Unknown sensor error." : "Unknown sensor error.";
        if (sensorErrors.Any(error => error.Kind == kind && error.Message == text)) return;
        sensorErrors.Add(new SensorDiagnostic(kind, text));
        if (sensorErrors.Count > 50) sensorErrors.RemoveAt(0);
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateVibrationEstimate(SensorReading reading)
    {
        if (lastVibrationEstimate is { } previousEstimate && (reading.TimestampUtc - previousEstimate).TotalMilliseconds < 200) return;
        lastVibrationEstimate = reading.TimestampUtc;
        var windowStart = reading.TimestampUtc.AddSeconds(-VibrationWindowSeconds);
        var window = recentReadings.Where(item => item.TimestampUtc >= windowStart)
            .Select(item => item.Acceleration ?? item.AccelerationIncludingGravity)
            .Where(vector => vector is not null).Select(vector => vector!.Value).ToArray();
        if (window.Length < 12) return;

        var durationSeconds = (reading.TimestampUtc - recentReadings.First(item => item.TimestampUtc >= windowStart).TimestampUtc).TotalSeconds;
        if (durationSeconds < 1) return;
        var sampleRate = (window.Length - 1) / durationSeconds;
        chartMaximumHz = Math.Clamp(sampleRate / 2, 0.5, 12.5);
        var magnitudes = window.Select(vector => vector.Magnitude).ToArray();
        var meanMagnitude = magnitudes.Average();
        currentVibrationRms = Math.Sqrt(magnitudes.Average(value => Math.Pow(value - meanMagnitude, 2)));
        currentVibrationFrequencyHz = EstimateDominantFrequency(window, sampleRate, chartMaximumHz);
        if (currentVibrationFrequencyHz is { } frequency)
        {
            vibrationHistory.Add(new VibrationPoint(reading.TimestampUtc, frequency));
            vibrationHistory.RemoveAll(point => (reading.TimestampUtc - point.TimestampUtc).TotalSeconds > VibrationHistorySeconds);
        }
    }

    private static double? EstimateDominantFrequency(IReadOnlyList<SensorVector3> samples, double sampleRate, double maximumFrequency)
    {
        if (samples.Count < 24 || sampleRate < 4) return null;
        var meanX = samples.Average(sample => sample.X); var meanY = samples.Average(sample => sample.Y); var meanZ = samples.Average(sample => sample.Z);
        var centered = samples.Select(sample => new SensorVector3(sample.X - meanX, sample.Y - meanY, sample.Z - meanZ)).ToArray();
        var firstLag = Math.Max(1, (int)Math.Floor(sampleRate / maximumFrequency));
        var finalLag = Math.Min(centered.Length / 2, (int)Math.Ceiling(sampleRate / 0.5));
        var bestCorrelation = 0d; var bestLag = 0;
        for (var lag = firstLag; lag <= finalLag; lag++)
        {
            var covariance = 0d; var firstEnergy = 0d; var secondEnergy = 0d;
            for (var index = 0; index < centered.Length - lag; index++)
            {
                var first = centered[index]; var second = centered[index + lag];
                covariance += (first.X * second.X) + (first.Y * second.Y) + (first.Z * second.Z);
                firstEnergy += first.Magnitude * first.Magnitude; secondEnergy += second.Magnitude * second.Magnitude;
            }
            var denominator = Math.Sqrt(firstEnergy * secondEnergy);
            var correlation = denominator > 0 ? covariance / denominator : 0;
            if (correlation > bestCorrelation) { bestCorrelation = correlation; bestLag = lag; }
        }
        return bestCorrelation < 0.2 || bestLag == 0 ? null : sampleRate / bestLag;
    }

    private static string ClassifyVibration(double? frequencyHz, double? rms, VibrationThresholdSettings settings)
    {
        if (rms is null) return "Waiting for signal";
        if (rms <= settings.StandingRmsMaxMetersPerSecondSquared) return "Standing";
        if (rms < settings.ActiveRmsMinMetersPerSecondSquared || frequencyHz is null) return "Unclassified motion";
        if (frequencyHz >= settings.WalkingMinHz && frequencyHz < settings.WalkingMaxHz) return "Walking-like";
        if (frequencyHz >= settings.RunningMinHz && frequencyHz < settings.RunningMaxHz) return "Running-like";
        if (frequencyHz >= settings.TruckMinHz && frequencyHz <= settings.TruckMaxHz) return "Truck-like vibration";
        return "Unclassified motion";
    }

    private string VibrationFrequencyPath()
    {
        if (vibrationHistory.Count == 0) return string.Empty;
        var now = latestReading?.TimestampUtc ?? DateTimeOffset.UtcNow;
        return string.Join(" ", vibrationHistory.Select((point, index) => $"{(index == 0 ? "M" : "L")}{XForTime(point.TimestampUtc, now)},{YForFrequency(point.FrequencyHz)}"));
    }

    private string XForTime(DateTimeOffset timestamp, DateTimeOffset now)
    {
        var elapsed = Math.Clamp((timestamp - now).TotalSeconds, -VibrationHistorySeconds, 0);
        return F(800 + (elapsed / VibrationHistorySeconds * 730));
    }

    private string YForFrequency(double frequency) => F(280 - (Math.Clamp(frequency, 0, chartMaximumHz) / chartMaximumHz * 250));
    private string AxisLabelY(int frequency) => F(280 - (frequency / chartMaximumHz * 250) - 8);
    private string BandHeight(double minimum, double maximum) => F(Math.Max(0, (Math.Min(maximum, chartMaximumHz) - Math.Min(minimum, chartMaximumHz)) / chartMaximumHz * 250));
    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private async Task SaveThresholds()
    {
        try
        {
            thresholds.Validate();
            thresholdMessage = drawingModule is null || !await drawingModule.InvokeAsync<bool>("saveVibrationThresholds", thresholds)
                ? "Values apply in this view but could not be saved in this browser."
                : "Thresholds saved in this browser and applied to the live vibration label.";
        }
        catch (ArgumentException exception) { thresholdMessage = exception.Message; }
    }

    private async Task ResetThresholds()
    {
        thresholds = new VibrationThresholdSettings();
        await SaveThresholds();
    }

    private static SensorVector3? Vector(JsonElement sample, string prefix)
    {
        var x = Number(sample, $"{prefix}X"); var y = Number(sample, $"{prefix}Y"); var z = Number(sample, $"{prefix}Z");
        return x is null || y is null || z is null ? null : new SensorVector3(x.Value, y.Value, z.Value);
    }

    private static double? Number(JsonElement element, string property) =>
        element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.Number && value.TryGetDouble(out var number) && double.IsFinite(number) ? number : null;

    private static bool Boolean(JsonElement element, string property) => element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.True;
    private static string Vector(SensorVector3? vector) => vector is { } value ? $"{value.X:0.00} / {value.Y:0.00} / {value.Z:0.00}" : "—";
    private static string Scalar(double? value, string suffix) => value is { } number ? $"{number:0.00}{suffix}" : "—";
    private static string Icon(SensorKind kind) => kind switch { SensorKind.Accelerometer => "⌁", SensorKind.Gyroscope => "⟳", SensorKind.Magnetometer => "⌖", SensorKind.Orientation => "◉", SensorKind.DeviceMotion => "↝", _ => "◌" };
    private static string Description(SensorKind kind) => kind switch
    {
        SensorKind.Accelerometer => "Linear acceleration in m/s²",
        SensorKind.Gyroscope => "Angular rate in degrees per second",
        SensorKind.Magnetometer => "Magnetic field in microteslas",
        SensorKind.Orientation => "Device attitude and compass heading",
        SensorKind.DeviceMotion => "Combined accelerometer and rotation event",
        SensorKind.Barometer => "Ambient pressure in kilopascals",
        _ => "Device sensor"
    };

    private void ClearHistory() { recentReadings.Clear(); receivedSamples = 0; latestReading = null; previousTimestampMilliseconds = null; observedRateHz = null; }

    public async ValueTask DisposeAsync()
    {
        if (drawingModule is not null)
        {
            try { await drawingModule.InvokeVoidAsync("stop"); } catch (JSDisconnectedException) { }
            await drawingModule.DisposeAsync();
        }
        dotnetReference?.Dispose();
    }
}
