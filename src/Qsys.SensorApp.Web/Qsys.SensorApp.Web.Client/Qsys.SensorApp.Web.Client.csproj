<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <Target Name="SetCommitInformationalVersion" BeforeTargets="GenerateAssemblyInfo">
    <Exec Command="git rev-parse --short=8 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitShort" />
    </Exec>
    <PropertyGroup Condition="'$(GitCommitShort)' != ''">
      <InformationalVersion>1.0.0+$(GitCommitShort)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\Qsys.SensorApp.Shared\Qsys.SensorApp.Shared.csproj" />
    <ProjectReference Include="..\..\Qsys.SensorApp.Core\Qsys.SensorApp.Core.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

</Project>
